  const [left, top, width, height] = mapView;
  const zoom = Math.max(6, Math.min(18, Math.ceil(6 + Math.log2(mapPixelScale() * Math.min(window.devicePixelRatio || 1, 2)))));
  const size = 256 / 2 ** (zoom - 6);
